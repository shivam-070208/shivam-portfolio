# Environment variables for Bitsketcher app

# The public-facing site URL (change this to your deployed domain if needed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Wix client configuration (example, replace with real if needed)
WIX_CLIENT_ID=your-wix-client-id

# GitHub token for API access (do NOT commit your real token)
GITHUB_TOKEN=your-github-token

# Gmail authentication (use app password, do NOT commit real credentials)
GMAIL_APP_PASSSWORD=your-gmail-app-password
GMAIL_USER=your-gmail-address@example.com

